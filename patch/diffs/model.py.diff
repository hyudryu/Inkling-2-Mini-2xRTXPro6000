+    def forward(self, lm_head, hidden_states, embedding_bias=None, skip_gather=False):
+        # Same as LogitsProcessor.forward, with the soft-cap's three
+        # elementwise passes fused into one in-place kernel (bit-identical).
+        if self.logits_as_input or self.soft_cap is None:
+            return super().forward(lm_head, hidden_states, embedding_bias, skip_gather)
+        logits = self._get_logits(hidden_states, lm_head, embedding_bias, skip_gather)
+        if logits is not None:
+            if use_fused_softcap(logits):
+                softcap_(logits, self.soft_cap)
+            else:
+                logits = torch.tanh(logits / self.soft_cap) * self.soft_cap
+            if self.scale != 1.0:
+                logits *= self.scale
+        return logits
+
 
